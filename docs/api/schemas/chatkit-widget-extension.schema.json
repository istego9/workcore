{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChatForkWidgetExtension",
  "description": "Additive widget extension components rendered by WorkCore capability-aware chat clients while preserving the canonical ChatKit transport contract.",
  "oneOf": [
    {
      "$ref": "#/definitions/dataTable"
    },
    {
      "$ref": "#/definitions/richChart"
    }
  ],
  "definitions": {
    "dataTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["DataTable"]
        },
        "title": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "align": { "type": "string", "enum": ["left", "center", "right"] }
            },
            "required": ["key", "label"]
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "required": ["type", "columns", "rows"]
    },
    "richChart": {
      "type": "object",
      "additionalProperties": false,
      "examples": [
        {
          "type": "RichChart",
          "spec_version": "1",
          "title": "Budget allocation",
          "chart_type": "pie",
          "data": [
            { "id": "Needs", "value": 55 },
            { "id": "Savings", "value": 25 },
            { "id": "Wants", "value": 20 }
          ],
          "nivo_props": {
            "height": 280,
            "innerRadius": 0.6,
            "padAngle": 1,
            "cornerRadius": 3
          }
        },
        {
          "type": "RichChart",
          "spec_version": "1",
          "title": "Cashflow trend",
          "chart_type": "line",
          "xAxis": "month",
          "data": [
            { "month": "Jan", "actual": 1200, "target": 1100 },
            { "month": "Feb", "actual": 1350, "target": 1200 },
            { "month": "Mar", "actual": 1280, "target": 1250 }
          ],
          "series": [
            { "type": "line", "dataKey": "actual", "label": "Actual" },
            { "type": "line", "dataKey": "target", "label": "Target" }
          ],
          "nivo_props": {
            "height": 280
          }
        }
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["RichChart"]
        },
        "spec_version": {
          "type": "string",
          "const": "1"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "chart_type": {
          "type": "string",
          "enum": [
            "bar",
            "line",
            "pie",
            "area-bump",
            "bump",
            "boxplot",
            "bullet",
            "calendar",
            "chord",
            "circle-packing",
            "funnel",
            "geo",
            "heatmap",
            "icicle",
            "marimekko",
            "network",
            "parallel-coordinates",
            "polar-bar",
            "radar",
            "radial-bar",
            "sankey",
            "scatterplot",
            "stream",
            "sunburst",
            "swarmplot",
            "tree",
            "treemap",
            "waffle"
          ]
        },
        "nivo_props": {
          "type": "object",
          "additionalProperties": true
        },
        "xAxis": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "data": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "required": ["type", "spec_version", "chart_type", "data"]
    }
  }
}
